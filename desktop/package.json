{
  "name": "fan-dvizhok-desktop",
  "version": "1.0.6",
  "private": true,
  "description": "Flux CRM",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "md.fan.dvizhok",
    "productName": "Flux CRM",
    "files": [
      "**/*",
      "!node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "../web/fan-device.js",
        "to": "web/fan-device.js"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "icon": "build/icon.ico"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}