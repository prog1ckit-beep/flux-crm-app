<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111318"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textColor="#E8E8EE"
        android:textSize="20sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/serverUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/server_url_hint"
        android:inputType="textUri"
        android:textColor="#E8E8EE"
        android:textColorHint="#8A8FA3"
        android:backgroundTint="#8A8FA3" />

    <EditText
        android:id="@+id/allowHosts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/allow_hosts_hint"
        android:inputType="textUri"
        android:textColor="#E8E8EE"
        android:textColorHint="#8A8FA3"
        android:backgroundTint="#8A8FA3"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/scanQr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/scan_qr"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_open"
        android:backgroundTint="#FF4FA3"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8A8FA3"
        android:layout_marginTop="12dp" />
</LinearLayout>
